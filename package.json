{
  "name": "beyaz-tahta",
  "version": "0.3.15",
  "description": "Kişisel sonsuz beyaz tahta uygulaması",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win",
    "release": "electron-builder --win --publish always"
  },
  "build": {
    "appId": "com.local.beyaztahta",
    "productName": "Beyaz Tahta",
    "files": [
      "src/**/*",
      "build/icon.png"
    ],
    "fileAssociations": [
      {
        "ext": "tahta",
        "name": "Beyaz Tahta Dosyası",
        "description": "Beyaz Tahta Dosyası"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Beyaz Tahta",
      "artifactName": "BeyazTahta-Kurulum-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "deezwend",
        "repo": "beyaz-tahta",
        "releaseType": "release"
      }
    ]
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "pdfjs-dist": "^4.10.38"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "katex": "^0.16.22",
    "markdown-it": "^14.1.0"
  }
}
